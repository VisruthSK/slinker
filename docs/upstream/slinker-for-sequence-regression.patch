+fn for_sequence_reads_the_binding_before_loop_initialization() {
+    let source = "f <- function() { for (x in x) {}; x }";
+    let parsed = parse_source(source);
+    let sequence = source.find("in x").unwrap() + 3;
+    assert!(parsed.expressions[0].references.iter().any(|reference| {
+        reference.name == "x" && reference.span.start == sequence
+    }));
+}
