 // --- For loops ---
 
+#[test]
+fn test_for_sequence_precedes_loop_variable_initialization() {
+    let index = index("for (x in x) { x }; x");
+    let file = ScopeId::from(0);
+    let map = index.use_def_map(file);
+
+    let sequence = map.bindings_at_use(UseId::from(0));
+    assert!(sequence.definitions().is_empty());
+    assert!(sequence.may_be_unbound());
+    for use_id in [UseId::from(1), UseId::from(2)] {
+        let bindings = map.bindings_at_use(use_id);
+        assert_eq!(bindings.definitions(), &[DefinitionId::from(0)]);
+        assert_not!(bindings.may_be_unbound());
+    }
+}
+
+#[test]
+fn test_for_sequence_resolves_effects_before_binding_the_variable() {
+    let index = crate::common::index_with_base("for (quote in list(quote(x))) quote");
+    assert!(index.uses_of("x").is_empty());
+}
+
+#[test]
+fn test_for_sequence_keeps_the_preceding_definition() {
+    let index = index("x <- 1; for (x in x) {}; x");
+    let file = ScopeId::from(0);
+    let map = index.use_def_map(file);
+
+    let sequence = map.bindings_at_use(UseId::from(0));
+    assert_eq!(sequence.definitions(), &[DefinitionId::from(0)]);
+    assert_not!(sequence.may_be_unbound());
+    let after = map.bindings_at_use(UseId::from(1));
+    assert_eq!(after.definitions(), &[DefinitionId::from(1)]);
+    assert_not!(after.may_be_unbound());
+}
+
